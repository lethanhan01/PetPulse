    "faq": {
      "sectionTitle": "Frequently Asked Questions",
      "sectionDesc": "Common questions about PetPulse",
      "items": {
        "free": {
          "q": "Is PetPulse free?",
          "a": "Yes! You can start with the forever free plan, managing up to 3 pets. When you need to unlock all features, you can upgrade to Premium anytime."
        },
        "multiplePets": {
          "q": "Can I manage multiple pets?",
          "a": "Yes. The Free plan allows up to 3 pets. If you have more, the Premium plan supports unlimited pets, along with advanced features like AI Symptom Checker."
        },
        "aiAccuracy": {
          "q": "Is the AI Symptom Checker accurate?",
          "a": "The AI uses large language models to analyze symptoms based on veterinary databases. Results are for reference only and do not replace a vet's diagnosis."
        },
        "security": {
          "q": "Is my data secure?",
          "a": "Absolutely. We apply top-tier security standards: end-to-end encryption, multi-factor authentication, and compliance with privacy regulations."
        },
        "cancel": {
          "q": "Can I cancel Premium anytime?",
          "a": "Yes. You can cancel Premium anytime without additional fees. Benefits will remain until the end of the current billing cycle."
        },
        "supportedPets": {
          "q": "What pets does PetPulse support?",
          "a": "We support Dogs, Cats, Birds, Fish, Hamsters, and many other common pets."
        }
      }
    },
